# Copy this file to .env and fill in your OKX DEMO keys.
# Create demo keys while in OKX Demo Trading mode (Trade -> Demo Trading, then Profile -> API).
# These are NOT your real-account keys. Keep DEMO=true until you have verified results.

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# true  -> OKX simulated (demo) trading, fake money. Leave this as true for now.
# false -> real money. Do not change until you have read the README and mean it.
DEMO=true

# What and how to trade.
SYMBOL=BTC/USDT
TIMEFRAME=15m
POLL_SECONDS=60

# Strategy parameters.
EMA_FAST=9
EMA_SLOW=21
ATR_PERIOD=14
ATR_STOP_MULT=2.0

# Risk limits.
RISK_FRACTION=0.01        # risk 1% of equity per trade, sized against the ATR stop
MAX_NOTIONAL_USD=50       # never put more than this into a single position
MAX_DAILY_LOSS_USD=20     # stop opening trades once the day is down this much

# Backtest only.
FEE_RATE=0.001
BACKTEST_START_EQUITY=1000
