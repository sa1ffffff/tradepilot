# Copy this file to .env and fill in your OKX DEMO keys.
# Create demo keys while in OKX Demo Trading mode (Trade -> Demo Trading, then Profile -> API).
# These are NOT your real-account keys. Keep DEMO=true until you have verified results.

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# true  -> OKX simulated (demo) trading, fake money. Leave this as true for now.
# false -> real money. Do not change until you have read the README and mean it.
DEMO=true

# API host. If www.okx.com times out or fails TLS on your network, use app.okx.com.
# Accounts registered under OKX EEA use my.okx.com.
OKX_HOSTNAME=app.okx.com

# What to trade. strategy.json overrides these with what it was researched on.
SYMBOL=BTC/USDT
TIMEFRAME=15m
POLL_SECONDS=60

# The strategy itself (and its stop) lives in strategy.json, written by
#   python research.py --save
# If strategy.json is missing the bot falls back to a plain EMA 9/21 cross.

# Risk limits.
RISK_FRACTION=0.01        # risk 1% of equity per trade, sized against the ATR stop
MAX_NOTIONAL_USD=50       # never put more than this into a single position
MAX_DAILY_LOSS_USD=20     # stop opening trades once the day is down this much

# Execution. maker = post-only limit at the best bid/ask, re-priced up to MAKER_ATTEMPTS
# times, MAKER_WAIT_SECONDS each, then a market order for whatever is left.
# Stop-loss exits always use a market order. taker = market orders only.
EXECUTION=maker
MAKER_WAIT_SECONDS=20
MAKER_ATTEMPTS=3

# Costs (OKX regular spot tier; run check_connection.py to see your account's real rates).
MAKER_FEE=0.0008
TAKER_FEE=0.0010
SLIPPAGE_BPS=2            # assumed slippage on market orders, in basis points
MAKER_FILL_RATE=0.7       # research assumes this share of maker attempts fill; session_report measures it
MAX_COST_PER_R=0.2        # skip entries where round-trip costs exceed 20% of the amount risked

# Backtest / research only.
BACKTEST_START_EQUITY=1000
